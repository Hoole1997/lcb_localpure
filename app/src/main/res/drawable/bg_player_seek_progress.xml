<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape><size android:height="4dp" /><corners android:radius="2dp" /><solid android:color="#66FFFFFF" /></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:width="4dp">
        <clip>
            <shape><size android:height="4dp" /><corners android:radius="2dp" /><gradient android:angle="0" android:startColor="#C62DEF" android:endColor="#7731F4" /></shape>
        </clip>
    </item>
</layer-list>
