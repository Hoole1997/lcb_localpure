<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/localMusicRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_page"
    tools:context=".localmusic.LocalMusicActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:minHeight="56dp"
            app:contentScrim="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimAnimationDuration="180"
            app:statusBarScrim="@android:color/transparent"
            app:titleEnabled="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/libraryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="1.0">

                <TextView
                    android:id="@+id/libraryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="@string/local_music_device_title"
                    android:textColor="#F7FFFFFF"
                    android:textSize="27sp"
                    app:layout_constraintEnd_toStartOf="@id/playAll"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/librarySummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#A8FFFFFF"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toStartOf="@id/playAll"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/libraryTitle"
                    tools:text="24 songs · 3 folders" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playAll"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="104dp"
                    android:paddingHorizontal="15dp"
                    android:text="@string/recommended_play_all"
                    android:textAllCaps="false"
                    android:textColor="#FF241A2E"
                    android:textSize="13sp"
                    app:backgroundTint="#F2FFFFFF"
                    app:cornerRadius="21dp"
                    app:icon="@drawable/ic_local_play"
                    app:iconGravity="textStart"
                    app:iconPadding="7dp"
                    app:iconTint="#FF241A2E"
                    app:layout_constraintBottom_toBottomOf="@id/librarySummary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/libraryTitle" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/folderList"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="18dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/librarySummary"
                    tools:listitem="@layout/item_local_music_folder" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                app:layout_collapseMode="pin"
                app:titleCentered="false"
                app:titleTextAppearance="@style/TextAppearance.LocalMusic.Toolbar" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trackList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="4dp"
            android:paddingBottom="20dp"
            tools:listitem="@layout/item_local_music_track" />

        <LinearLayout
            android:id="@+id/stateContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="42dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_home_shortcut_local"
                android:contentDescription="@null"
                android:padding="15dp"
                android:src="@drawable/ic_home_local_playlist" />

            <TextView
                android:id="@+id/stateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#F7FFFFFF"
                android:textSize="19sp"
                tools:text="Access your music" />

            <TextView
                android:id="@+id/stateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="#A6FFFFFF"
                android:textSize="14sp"
                tools:text="Allow access to music stored on this device." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/stateAction"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="124dp"
                android:paddingHorizontal="20dp"
                android:textAllCaps="false"
                android:textColor="#FF241A2E"
                android:textSize="14sp"
                app:backgroundTint="#F2FFFFFF"
                app:cornerRadius="22dp"
                tools:text="Allow access" />
        </LinearLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:visibility="gone"
            app:indicatorColor="#E8A8EC"
            app:trackColor="#20FFFFFF"
            tools:visibility="visible" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/miniPlayerHost"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.behavior.HideBottomViewOnScrollBehavior">

        <include
            android:id="@+id/miniPlayer"
            layout="@layout/view_home_mini_player"
            android:layout_width="match_parent"
            android:layout_height="60dp" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
