<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_player_page">

    <ImageButton
        android:id="@+id/back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/player_toolbar_margin_top"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_close"
        android:padding="12dp"
        android:src="@drawable/ic_player_v_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/trackInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/player_toolbar_margin_top"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintEnd_toStartOf="@id/share"
        app:layout_constraintStart_toEndOf="@id/back"
        app:layout_constraintTop_toTopOf="parent">

        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#F5FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:background="?attr/selectableItemBackgroundBorderless" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:minHeight="28dp" android:paddingHorizontal="8dp" android:textColor="#CCFFFFFF" android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/share"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/player_toolbar_margin_top"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/player_share"
        android:padding="12dp"
        android:src="@drawable/ic_player_v_share"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.lcb.app.player.PlayerTrackFlipView
        android:id="@+id/artwork"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/seekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/trackInfo" />

    <ImageButton android:id="@+id/addToPlaylist" style="@style/PlayerSmallButton" android:contentDescription="@string/player_add_playlist" android:src="@drawable/ic_player_v_add" app:layout_constraintBottom_toTopOf="@id/seekBar" app:layout_constraintStart_toStartOf="parent" />
    <ImageButton android:id="@+id/favorite" style="@style/PlayerSmallButton" android:contentDescription="@string/player_favorite" android:src="@drawable/ic_player_v_favorite" app:layout_constraintBottom_toTopOf="@id/seekBar" app:layout_constraintEnd_toEndOf="parent" />

    <!-- 时间与进度条共享上下约束，在字体缩放下仍保持同一条视觉中轴。 -->
    <TextView
        android:id="@+id/currentTime"
        style="@style/PlayerTime"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@id/seekBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/seekBar" />

    <com.example.lcb.app.player.GradientSeekBar
        android:id="@+id/seekBar"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginBottom="@dimen/player_seek_control_gap"
        android:contentDescription="@string/player_seek"
        app:layout_constraintBottom_toTopOf="@id/play"
        app:layout_constraintEnd_toStartOf="@id/duration"
        app:layout_constraintStart_toEndOf="@id/currentTime" />

    <TextView
        android:id="@+id/duration"
        style="@style/PlayerTime"
        android:gravity="center_vertical|end"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@id/seekBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/seekBar" />

    <ImageButton android:id="@+id/shuffle" style="@style/PlayerControlButton" android:contentDescription="@string/player_shuffle" android:src="@drawable/ic_player_v_shuffle" app:layout_constraintBottom_toBottomOf="@id/play" app:layout_constraintEnd_toStartOf="@id/previous" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/play" />
    <ImageButton android:id="@+id/previous" style="@style/PlayerControlButton" android:contentDescription="@string/player_previous" android:src="@drawable/ic_player_v_previous" app:layout_constraintBottom_toBottomOf="@id/play" app:layout_constraintEnd_toStartOf="@id/play" app:layout_constraintStart_toEndOf="@id/shuffle" app:layout_constraintTop_toTopOf="@id/play" />
    <ImageButton android:id="@+id/play" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginBottom="@dimen/player_control_bottom_margin" android:background="@drawable/bg_player_play_button" android:contentDescription="@string/home_play" android:padding="14dp" android:src="@drawable/ic_player_v_play" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
    <ImageButton android:id="@+id/next" style="@style/PlayerControlButton" android:contentDescription="@string/player_next" android:src="@drawable/ic_player_v_next" app:layout_constraintBottom_toBottomOf="@id/play" app:layout_constraintEnd_toStartOf="@id/queue" app:layout_constraintStart_toEndOf="@id/play" app:layout_constraintTop_toTopOf="@id/play" />
    <ImageButton android:id="@+id/queue" style="@style/PlayerControlButton" android:contentDescription="@string/player_queue" android:src="@drawable/ic_player_v_queue" app:layout_constraintBottom_toBottomOf="@id/play" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@id/next" app:layout_constraintTop_toTopOf="@id/play" />
</androidx.constraintlayout.widget.ConstraintLayout>
