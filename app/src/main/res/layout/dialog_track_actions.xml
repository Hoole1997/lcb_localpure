<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_track_actions_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_track_action_handle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp">

        <com.example.lcb.app.ui.TrackArtworkView
            android:id="@+id/cover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_track_action_cover"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/track_action_text_primary"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/artist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cover"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Music Name" />

        <TextView
            android:id="@+id/artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/track_action_text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cover"
            app:layout_constraintTop_toBottomOf="@id/title"
            tools:text="Singer Name" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/songInfoAction"
        style="@style/TrackAction.Row"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/track_action_song_info">

        <ImageView
            style="@style/TrackAction.Icon"
            android:src="@drawable/ic_track_action_song_info" />

        <TextView
            style="@style/TrackAction.Label"
            android:text="@string/track_action_song_info" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/addToPlaylistAction"
        style="@style/TrackAction.Row"
        android:contentDescription="@string/track_action_add_to_playlist">

        <ImageView
            style="@style/TrackAction.Icon"
            android:src="@drawable/ic_track_action_add_playlist" />

        <TextView
            style="@style/TrackAction.Label"
            android:text="@string/track_action_add_to_playlist" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/downloadAction"
        style="@style/TrackAction.Row"
        android:contentDescription="@string/track_action_download">

        <ImageView
            style="@style/TrackAction.Icon"
            android:src="@drawable/ic_track_action_download" />

        <TextView
            style="@style/TrackAction.Label"
            android:text="@string/track_action_download" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/favoriteAction"
        style="@style/TrackAction.Row"
        android:contentDescription="@string/track_action_favorite">

        <ImageView
            android:id="@+id/favoriteIcon"
            style="@style/TrackAction.Icon"
            android:src="@drawable/ic_track_action_favorite" />

        <TextView
            android:id="@+id/favoriteLabel"
            style="@style/TrackAction.Label"
            android:text="@string/track_action_favorite" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/deleteFromDeviceAction"
        style="@style/TrackAction.Row"
        android:contentDescription="@string/track_action_delete_from_device">

        <ImageView
            style="@style/TrackAction.Icon"
            android:src="@drawable/ic_track_action_delete" />

        <TextView
            style="@style/TrackAction.Label"
            android:textColor="@color/track_action_danger"
            android:text="@string/track_action_delete_from_device" />
    </LinearLayout>
</LinearLayout>
