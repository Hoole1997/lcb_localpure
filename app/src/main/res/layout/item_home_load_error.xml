<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_home_shortcut_neutral"
    android:gravity="center"
    android:minHeight="156dp"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="22dp">

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        tools:text="Unable to load music. Check your connection and try again." />

    <TextView
        android:id="@+id/retry"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_retry"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="92dp"
        android:paddingHorizontal="20dp"
        android:text="@string/search_retry"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

</LinearLayout>
