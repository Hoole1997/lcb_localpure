<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="118dp"
    android:layout_height="148dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">
    <FrameLayout android:id="@+id/card" android:layout_width="118dp" android:layout_height="118dp" android:background="@drawable/bg_home_shortcut_neutral">
        <ImageView android:id="@+id/artwork" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="centerCrop" android:visibility="gone" />
        <ImageView android:id="@+id/icon" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center" android:contentDescription="@null" />
    </FrameLayout>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="@android:color/white" android:textSize="14sp" />
</LinearLayout>
