<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="9dp">
    <com.example.lcb.app.home.HomeTrackArtworkView
        android:id="@+id/cover"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_home_cover" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/title" style="@style/HomeTrackTitle" />
        <TextView android:id="@+id/artist" style="@style/HomeTrackArtist" android:layout_marginTop="8dp" />
    </LinearLayout>
    <ImageButton android:id="@+id/more" style="@style/HomeTrackAction" android:contentDescription="@string/home_more" android:src="@drawable/ic_home_more" />
</LinearLayout>
